{
  "schema": "nativegpu.vegetation-texture-roles/1",
  "comment": "Authoring texture set for oak, from assets/source/vegetation/oak-imagegen-v1/complete (1254x1254, AI-inferred prototype, not measured PBR). Every role declares its machine-readable semantic, colour space and filter so the cook never has to guess from a file name. Roles are named after what they are, not after the slot they happen to fill: `bark_orm` is an ORM map with R=AO, G=roughness, B=metallic=0, and the shader unpacks it. The previous table mapped a height map to `bark_roughness`, an ORM map to `bark_albedo_moss`, an ORM map to `leaf_atlas_autumn` and a thickness map to `leaf_mask`; those roles are gone rather than renamed, because renaming a wrong-purpose image keeps the wrong data. `filter` is explicit: colour averages in linear light, normal renormalises, coverage preserves alpha-test coverage, data is a plain box filter. `coverageCutoff` must equal the runtime alpha cutoff the shader discards at.",
  "roles": {
    "bark_basecolor": {
      "source": "oak_bark_basecolor.png",
      "semantic": "baseColor",
      "colorSpace": "srgb",
      "srgb": true,
      "size": 1024,
      "filter": "color",
      "tileMetres": 1.6
    },
    "bark_normal": {
      "source": "oak_bark_normal_dx.png",
      "semantic": "normal",
      "colorSpace": "linear",
      "normalConvention": "directX-",
      "srgb": false,
      "size": 1024,
      "filter": "normal",
      "tileMetres": 1.6
    },
    "bark_orm": {
      "source": "oak_bark_orm.png",
      "semantic": "orm",
      "colorSpace": "linear",
      "channels": { "R": "occlusion", "G": "roughness", "B": "metallic" },
      "srgb": false,
      "size": 512,
      "filter": "data",
      "tileMetres": 1.6
    },
    "bark_height": {
      "source": "oak_bark_height.png",
      "semantic": "height",
      "colorSpace": "linear",
      "encoding": "white = raised, black = recessed, not calibrated metres",
      "srgb": false,
      "size": 512,
      "filter": "data",
      "tileMetres": 1.6
    },
    "leaf_basecolor": {
