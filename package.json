    "fogtown:generate": "node tools/fogtown/generate.mjs",
    "fogtown:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fogtown.ps1 -Verify",
    "fogtown:package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fogtown.ps1 -Package",
    "assets": "node tools/assets.mjs",
