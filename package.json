    "voronoi": "node tools/offline/voronoi.mjs",
    "gltf": "node tools/offline/gltf.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
    "gameplay": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/core/gameplay.ps1",
