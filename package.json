    "image-regression": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/rendering/image-regression.ps1",
    "replay": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/core/replay.ps1",
