{
  "name": "nativegpu-engine",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Windows D3D12 native engine, deterministic scene tools and MCP editing surface",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-native.ps1",
    "scene": "node tools/scene.mjs",
    "probe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe.ps1",
    "mcp": "node ai/mcp-server.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bootstrap.ps1",
    "bootstrap:dxc": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bootstrap-dxc.ps1",
    "shaders": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/compile-shaders.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify.ps1",
    "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ci.ps1",
    "determinism": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/determinism.ps1",
    "budget": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/budget.ps1",
    "offline": "node tools/offline/geometry-package.mjs",
    "compute": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/compute.ps1",
    "image-regression": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/image-regression.ps1",
    "replay": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/replay.ps1",
    "contract": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/error-contract.ps1",
    "sdf": "node tools/offline/sdf-bake.mjs",
    "gltf": "node tools/offline/gltf.mjs",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1"
  }
}
