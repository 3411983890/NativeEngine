    "effects:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/effects-gpu.ps1",
    "effects:gpu:draw": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/effects-gpu-draw.ps1",
    "effects:fields": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/effects-fields.ps1",
    "effects:fields:host": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/field-host.ps1",
    "effects:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/effects-cpu.ps1",
