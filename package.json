    "test": "node --test tests/*.test.mjs",
    "test:editor": "node --test tests/editor-*.test.mjs",
    "editor": "node tools/editor.mjs",
    "editor:web": "node editor/server.mjs",
    "editor:frontend": "node editor/server.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/core/test-native.ps1",
    "animation": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/core/animation.ps1",
    "fields": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/fields.ps1",
    "fields:world:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/fields-world-gpu.ps1",
    "fields:local:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/fields-local-gpu.ps1",
