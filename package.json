{
  "name": "nativegpu-engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Windows D3D12 native engine, deterministic scene tools and MCP editing surface",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-native.ps1",
    "scene": "node tools/scene.mjs",
    "probe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe.ps1",
    "mcp": "node ai/mcp-server.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1"
  }
}
