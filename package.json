    "test:editor-camera": "node .incrementalTesting/editor/editor-camera-check.mjs",
    "test:editor-scene": "node .incrementalTesting/editor/scene-preview-check.mjs",
    "test:starter": "node --test tests/editor-project.test.mjs .incrementalTesting/editor/starter-paths.test.mjs && node .incrementalTesting/editor/starter-project-check.mjs",
    "smoke:host": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/rendering/smoke-host.ps1",
    "test:layered-material": "node --test .incrementalTesting/rendering/layered-material.test.mjs",
    "test:surface-relief": "node --test .incrementalTesting/rendering/surface-relief.test.mjs",
    "test:heightfield": "node --test .incrementalTesting/simulation/heightfield-collision.test.mjs",
    "fields:coordinator:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/field-coordinator-gpu.ps1",
    "fields:joint:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/fields-joint-gpu.ps1",
    "fields:services:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/fields-services-gpu.ps1",
    "smoke:fields": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/smoke-fields.ps1",
    "smoke:particles": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/smoke-particles.ps1",
    "smoke:service": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/smoke-service.ps1",
    "smoke:sharing": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/smoke-sharing.ps1",
    "test:water": "node .incrementalTesting/simulation/water-realism.mjs --cpu-only",
    "test:water:gpu": "node .incrementalTesting/simulation/water-gpu.mjs",
    "water:verify": "node .incrementalTesting/simulation/water-realism.mjs",
    "test:garment": "node --test .incrementalTesting/simulation/garment-weights-check.mjs",
    "test:garment:native": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/garment-skinned.ps1",
    "test:hair": "node --test .incrementalTesting/vegetation/hair-generator-check.mjs",
    "builtin:prepare": "node tools/builtin/prepare.mjs",
    "test:hair:draw": "node --test .incrementalTesting/vegetation/hair-render-check.mjs .incrementalTesting/vegetation/hair-gpu-pack-check.mjs",
    "test:hair:groom": "node --test .incrementalTesting/vegetation/hair-groom-native-check.mjs",
    "test:hair:gpu": "node --test .incrementalTesting/vegetation/hair-draw-native-check.mjs",
    "test:hair:host": "node --test .incrementalTesting/vegetation/hair-host-check.mjs",
    "hair:sample": "node tools/hair-sample-record.mjs",
    "hair:groom": "node tools/hair-groom.mjs",
    "world": "node tools/world.mjs",
    "world:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-world.ps1",
    "test:world": "node --test .incrementalTesting/core/world/world-contract.test.mjs",
    "test:world-native": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/core/world/test-world.ps1",
    "world:verify": "node .incrementalTesting/rendering/world/world-render-check.mjs"
