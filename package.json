  "devDependencies": {
    "electron": "44.9.1"
  },
  "dependencies": {
    "assimpjs": "^0.0.10",
    "draco3dgltf": "^1.5.9",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.3.0",
