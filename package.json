    "cloth:grouped": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/cloth-grouped.ps1",
    "water": "node tools/water.mjs",
    "simulation:suite": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/simulation-suite.ps1",
    "effects:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File .incrementalTesting/simulation/effects-runtime.ps1",
